# Шаблон .env — копия без реальных значений, безопасно коммитить.
# Реальный .env с настоящими ключами защищён .gitignore, в git не попадает.

# Exa (mcp__exa__web_search_exa / web_fetch_exa) — тот же ключ, что уже используется
# глобально Engineer/Авитологом (~/.claude.json), продублирован сюда 2026-09-12, чтобы
# .mcp.json этого агента не зависел от чужого файла вне репозитория.
EXA_API_KEY=

# Firecrawl (mcp__firecrawl__firecrawl_scrape / firecrawl_search) — токен с firecrawl.dev.
FIRECRAWL_API_KEY=
